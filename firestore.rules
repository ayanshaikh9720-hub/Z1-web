rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email in ['admin@z1movies.com', 'ayanshaikh9720@gmail.com'])
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Movies collection
    match /movies/{movieId} {
      allow get: if resource == null || resource.data.published == true || isAdmin();
      allow list: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Watchlists collection
    match /watchlists/{watchlistId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Playback Progress collection
    match /progress/{progressId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Views analytics events
    match /views/{viewId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Downloads analytics events
    match /downloads/{downloadId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Contacts collection
    match /contacts/{contactId} {
      allow create: if true;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Test connection probe
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
