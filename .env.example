# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign and verify HMAC session tokens across serverless instances.
JWT_SECRET="z1-movies-production-secret-key-2026"

# GOOGLE ADSENSE & AD PLACEMENTS (Disabled by default until account approval)
# Set VITE_ENABLE_ADS to true only after AdSense approval
VITE_ENABLE_ADS=false
VITE_ADSENSE_CLIENT_ID="ca-pub-129044328213055"
VITE_ADSENSE_SLOT_TOP=""
VITE_ADSENSE_SLOT_BETWEEN=""
